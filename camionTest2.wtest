
import camion2.*
describe "Tests camion y cosas" {
    test "paquete de ladrillos" {
        paqueteDeLadrillos.prepararPaquete(50)
        assert.equals(100, paqueteDeLadrillos.peso())
        assert.equals(2, paqueteDeLadrillos.peligrosidad())
    }

    test "bateria antiaerea" {
        bateriaAntiaerea.armarBateria()

        assert.equals(300, bateriaAntiaerea.peso())
        assert.equals(100, bateriaAntiaerea.peligrosidad())
    }

    test "contenedor portuario" {

        paqueteDeLadrillos.prepararPaquete(20)
        arenaAGranel.cargarArena(50)
        contenedor.agregarCosa(paqueteDeLadrillos)
        contenedor.agregarCosa(knightRider)
        contenedor.agregarCosa(arenaAGranel)

        assert.equals(690, contenedor.peso())
        assert.equals(10, contenedor.peligrosidad())
    }

    test "embalaje de seguridad" {
        residuosRadiactivos.cargarResiduos(30)
        embalajeDeSeguridad.embalar(residuosRadiactivos)
        assert.equals(30, embalajeDeSeguridad.peso())
        assert.equals(100, embalajeDeSeguridad.peligrosidad())
    }

    test "camion cargado completo" {

        bumblebee.transformar()
        arenaAGranel.cargarArena(150)
        bateriaAntiaerea.armarBateria()
        paqueteDeLadrillos.prepararPaquete(80)
        embalajeDeSeguridad.embalar(paqueteDeLadrillos)

        camion.agregarCarga(bumblebee)
        camion.agregarCarga(arenaAGranel)
        camion.agregarCarga(bateriaAntiaerea)
        camion.agregarCarga(embalajeDeSeguridad)
        // cambia por las consecuencias automaticas
        assert.equals(2424, camion.tara())
        assert.that(camion.cargaPar())
        assert.that(camion.hayCargaDePeso(300))
        assert.equals(bateriaAntiaerea,camion.primerObjetoPeligroso(100))
        assert.equals([bateriaAntiaerea], camion.cargasPeligrosas(50))
        assert.notThat(camion.estaExcedido())
        assert.that(camion.puedeCircular(150))
        assert.notThat(camion.puedeCircular(50))
        assert.that(camion.hayCargaEntre(100, 350))
        assert.equals(bumblebee,camion.indicarCargaMasPesada())
    }

    // =====================================
    // TESTS CONSECUENCIAS DE LA CARGA
    // =====================================

    test "bumblebee cambia a robot al cargarlo" {
        assert.equals(15, bumblebee.peligrosidad())
        camion.agregarCarga(bumblebee)
        assert.equals(30, bumblebee.peligrosidad())
    }

    test "arena a granel pierde 10 kilos al cargarla" {
        arenaAGranel.cargarArena(100)
        camion.agregarCarga(arenaAGranel)
        assert.equals(90, arenaAGranel.peso())
    }

    test "paquete de ladrillos agrega 12 ladrillos" {
        paqueteDeLadrillos.prepararPaquete(100)
        camion.agregarCarga(paqueteDeLadrillos)
        assert.equals(224, paqueteDeLadrillos.peso())
        assert.equals(2, paqueteDeLadrillos.bulto())
    }

    test "bateria antiaerea se carga automaticamente" {
        bateriaAntiaerea.desarmarBateria()
        camion.agregarCarga(bateriaAntiaerea)
        assert.equals(300, bateriaAntiaerea.peso())
        assert.equals(100, bateriaAntiaerea.peligrosidad())
    }

    test "residuos radioactivos aumentan 15 kilos" {
        residuosRadiactivos.cargarResiduos(20)
        camion.agregarCarga(residuosRadiactivos)
        assert.equals(35, residuosRadiactivos.peso())
    }

    test "contenedor hace reaccionar a lo que tiene dentro" {
        arenaAGranel.cargarArena(100)
        contenedor.agregarCosa(arenaAGranel)
        camion.agregarCarga(contenedor)
        assert.equals(90, arenaAGranel.peso())
    }
}

    // =====================================
    // TESTS MAP
    // =====================================

    test "obtener pesos de las cargas" {
        arenaAGranel.cargarArena(100)
        camion.agregarCarga(bumblebee)
        camion.agregarCarga(arenaAGranel)

        assert.equals([800, 90],camion.pesosDeLasCargas())
    }

    test "obtener niveles de peligrosidad" {

        bateriaAntiaerea.armarBateria()
        camion.agregarCarga(knightRider)
        camion.agregarCarga(bateriaAntiaerea)
        assert.equals([10, 100],camion.nivelesDePeligrosidad())
    }

    test "obtener bultos por carga" {

        paqueteDeLadrillos.prepararPaquete(50)
        camion.agregarCarga(paqueteDeLadrillos)
        camion.agregarCarga(bateriaAntiaerea)

        assert.equals([1, 2], camion.bultosPorCarga())
    }

    test "obtener pesos duplicados" {

        arenaAGranel.cargarArena(100)
        camion.agregarCarga(knightRider)
        camion.agregarCarga(arenaAGranel)

        assert.equals([1000, 180],  camion.pesosDuplicados() )
    }

    test "obtener pesos de cargas peligrosas" {
        bateriaAntiaerea.armarBateria()
        camion.agregarCarga(knightRider)
        camion.agregarCarga(bateriaAntiaerea)
        assert.equals( [300],camion.pesosDeCargasPeligrosas() )
    }